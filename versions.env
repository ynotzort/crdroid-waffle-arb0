# Pinned upstream state of everything this repo bolts onto crDroid.
# Sourced by env.sh. Move a pin deliberately, after a build + preflight pass.

# --- crDroid -----------------------------------------------------------------
CRDROID_MANIFEST=https://github.com/crdroidandroid/android.git
CRDROID_BRANCH=16.0
DEVICE=waffle
# The ROM version string the output zip carries; used only for globbing.
CRDROID_VERSION=v12.11

# --- KernelSU-Next (fork with SUSFS) ------------------------------------------
# pershoot's dev-susfs branch. NOT next-susfs: that branch stopped 2025-11 and no
# longer compiles against current SUSFS; it also numbers itself 10000+n and is
# rejected by every current Manager. dev-susfs is 30000+n (33252 here).
KSU_NEXT_REPO=https://github.com/pershoot/KernelSU-Next
KSU_NEXT_BRANCH=dev-susfs
KSU_NEXT_COMMIT=2963d2ffa66159a465856a66fcbbb09f19f48cd6   # 2026-08-29, v3.3.0 base

# --- SUSFS kernel patches ----------------------------------------------------
# Branch must match the kernel: android14-6.1-lts (6.1.175 on waffle).
SUSFS_REPO=https://gitlab.com/pershoot/susfs4ksu.git
SUSFS_BRANCH=gki-android14-6.1-lts-dev
SUSFS_COMMIT=ec676b5a726664bf439859b1433c5503475f1ac2      # 2026-08-30, v2.3.0
SUSFS_PATCH=50_add_susfs_in_gki-android14-6.1.patch

# --- ARB0 firmware donor -----------------------------------------------------
# The four OnePlus-signed bootloader images that carry (xbl_config) or pair with
# (xbl, xbl_ramdump, abl) the anti-rollback field. Taken as a coherent group
# from the newest official crDroid build that is still ARB 0. Hashes in
# arb0/manifest.*; the blobs themselves are not committed.
ARB0_DONOR="crDroid 16.0 v12.5 (2026-01-01) for waffle"
ARB0_BLOBS="abl xbl xbl_config xbl_ramdump"

# --- GApps flashed alongside (recorded, not distributed) ----------------------
GAPPS_NAME="NikGapps-crdroid-official-arm64-16-20251128"
GAPPS_SHA256=f7883e80dc900aa7b7e7f4de7d9be775a938cba5f262f3c39b9413ce4b7df718
